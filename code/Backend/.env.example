# Database Configuration
# Option 1: Use Supabase full connection string (recommended for Supabase)
# Get this from Supabase Console -> Project Settings -> Database -> Connection String (Session pooler, port 5432)
SUPABASE_DB_URL=jdbc:postgresql://db.xxxxx.supabase.co:5432/postgres?user=postgres.xxxxx&password=your-password

# Option 2: Use individual connection parameters (for local PostgreSQL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=freelance_hub
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

# Database Schema (use custom schema to avoid Supabase's public schema Data API exposure)
DB_SCHEMA=freelance_hub

# JWT Configuration
JWT_SECRET=your-very-secure-secret-key-change-this-in-production-min-256-bits
JWT_EXPIRATION=86400000

# Server Configuration
SERVER_PORT=8080

# Logging
LOG_LEVEL=DEBUG
SHOW_SQL=false

# CORS Origins (add your frontend URLs)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
