# PostgreSQL / Docker
POSTGRES_DB=freelance_hub
POSTGRES_USER=freelance_hub
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432

# Application
APP_PORT=8080
SERVER_PORT=8080

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/freelance_hub
SPRING_DATASOURCE_USERNAME=freelance_hub
SPRING_DATASOURCE_PASSWORD=change-this-local-password

# JPA
SPRING_JPA_DEFAULT_SCHEMA=public

# Flyway
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
SPRING_FLYWAY_SCHEMAS=public

# JWT
JWT_SECRET=your-very-secure-secret-key-change-this-in-production
JWT_EXPIRATION=900000
REFRESH_EXPIRATION_MS=604800000
REFRESH_COOKIE_SECURE=false

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# OpenAPI / Swagger
OPENAPI_ENABLED=true

# Logging
LOG_LEVEL=INFO
SHOW_SQL=false
