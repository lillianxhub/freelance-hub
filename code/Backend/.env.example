# PostgreSQL Configuration
POSTGRES_DB=freelance_hub
POSTGRES_USER=freelance_hub
POSTGRES_PASSWORD=freelance_hub_dev
POSTGRES_PORT=5432

# Application Configuration
APP_PORT=8080

# Spring Boot Datasource (for deployment)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/freelance_hub
SPRING_DATASOURCE_USERNAME=freelance_hub
SPRING_DATASOURCE_PASSWORD=freelance_hub_dev

# JWT Configuration
JWT_SECRET=your-very-secure-secret-key-change-this-in-production-min-256-bits
JWT_EXPIRATION=86400000

# CORS Configuration (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
