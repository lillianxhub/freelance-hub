# Local Development Configuration Template
# Copy this file to application-local.properties and fill in your values
# application-local.properties is git-ignored for security

# Supabase Database
SPRING_DATASOURCE_URL=jdbc:postgresql://your-project.supabase.co:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-database-password

# Schema - local development uses 'freelance_hub'
SPRING_JPA_DEFAULT_SCHEMA=freelance_hub
SPRING_FLYWAY_SCHEMAS=freelance_hub

# JWT Secret (minimum 256 bits - generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-key-change-this
JWT_EXPIRATION=86400000
